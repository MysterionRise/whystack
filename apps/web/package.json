{
  "name": "@ai-cto-cockpit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "next build",
    "check": "eslint . --max-warnings=0 && tsc --noEmit",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "contracts:generate": "node scripts/generate-contracts.mjs --write",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@copilotkit/react-core": "1.63.2",
    "@copilotkit/react-ui": "1.63.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
