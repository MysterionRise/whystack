# Runtime profile: public-demo or local-data
APP_MODE=public-demo
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Use a long random value in deployed environments.
SESSION_SIGNING_KEY=
SESSION_SIGNING_KEY_ID=cookie-key-v1
SESSION_RETAINED_SIGNING_KEYS={}
SESSION_RETAINED_COOKIE_SECURE={}
# Local HTTP Compose may use false; deployed profiles must use true.
COOKIE_SECURE=false
LOCAL_COMPOSE=true

# Local Compose service connections.
DATABASE_URL=postgresql+psycopg://ai_cto:ai_cto@postgres:5432/ai_cto
QDRANT_URL=http://qdrant:6333

# Remote inference. This key remains server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional read-only GitHub connector for local-data mode.
GITHUB_TOKEN=

# Privacy-preserving telemetry defaults.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true
LOG_LEVEL=INFO

# Public-demo guardrails.
DEMO_OVERLAY_TTL_HOURS=24
DEMO_REQUESTS_PER_MINUTE=5
DEMO_TURNS_PER_DAY=50
DEMO_CONCURRENT_RUNS=2
DEMO_DAILY_SPEND_USD=10
